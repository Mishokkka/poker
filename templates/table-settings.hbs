{{#if missing}}
<section class="fbl-poker-missing">{{localize "FBLPoker.Errors.TableMissing"}}</section>
{{else}}
<section class="fbl-poker-form">
  <header class="fbl-poker-form-intro">
    <span class="fbl-poker-toolbar-emblem"><i class="fa-solid fa-sliders"></i></span>
    <div>
      <h2>{{localize "FBLPoker.Edit.Heading"}}</h2>
      <p>{{localize "FBLPoker.Edit.Subtitle"}}</p>
    </div>
  </header>

  <fieldset class="fbl-poker-fieldset">
    <legend>{{localize "FBLPoker.Create.Sections.General"}}</legend>
    <div class="form-group fbl-poker-span-2">
      <label for="fbl-poker-edit-name">{{localize "FBLPoker.Fields.Name"}}</label>
      <input id="fbl-poker-edit-name" type="text" name="name" value="{{table.name}}" maxlength="80" autocomplete="off" required>
    </div>
    <div class="fbl-poker-form-grid">
      <div class="form-group">
        <label for="fbl-poker-edit-seats">{{localize "FBLPoker.Fields.MaxSeats"}}</label>
        <input id="fbl-poker-edit-seats" type="number" name="maxSeats" value="{{table.maxSeats}}" min="2" max="10" required {{#if hasSeats}}readonly{{/if}}>
      </div>
      <div class="form-group">
        <label for="fbl-poker-edit-time">{{localize "FBLPoker.Fields.ActionSeconds"}}</label>
        <input id="fbl-poker-edit-time" type="number" name="actionSeconds" value="{{table.actionSeconds}}" min="10" max="300" required>
      </div>
    </div>
    {{#if hasSeats}}<p class="fbl-poker-field-hint"><i class="fa-solid fa-lock"></i> {{localize "FBLPoker.Edit.SeatsLockedHint"}}</p>{{/if}}
  </fieldset>

  <fieldset class="fbl-poker-fieldset">
    <legend>{{localize "FBLPoker.Create.Sections.Structure"}}</legend>
    <div class="fbl-poker-form-grid">
      <div class="form-group">
        <label for="fbl-poker-edit-sb">{{localize "FBLPoker.Fields.SmallBlind"}}</label>
        <input id="fbl-poker-edit-sb" type="number" name="smallBlind" value="{{table.smallBlind}}" min="0" required>
      </div>
      <div class="form-group">
        <label for="fbl-poker-edit-bb">{{localize "FBLPoker.Fields.BigBlind"}}</label>
        <input id="fbl-poker-edit-bb" type="number" name="bigBlind" value="{{table.bigBlind}}" min="1" required>
      </div>
      <div class="form-group">
        <label for="fbl-poker-edit-ante">{{localize "FBLPoker.Fields.Ante"}}</label>
        <input id="fbl-poker-edit-ante" type="number" name="ante" value="{{table.ante}}" min="0" required>
      </div>
      <div class="form-group">
        <label for="fbl-poker-edit-chip">{{localize "FBLPoker.Fields.ChipValueCopper"}}</label>
        <input id="fbl-poker-edit-chip" type="number" name="chipValueCopper" value="{{table.chipValueCopper}}" min="1" required {{#if hasSeats}}readonly{{/if}}>
      </div>
    </div>
    {{#if hasSeats}}<p class="fbl-poker-field-hint"><i class="fa-solid fa-lock"></i> {{localize "FBLPoker.Edit.ChipValueLockedHint"}}</p>{{/if}}
  </fieldset>

  <fieldset class="fbl-poker-fieldset">
    <legend>{{localize "FBLPoker.Create.Sections.BuyIn"}}</legend>
    <div class="fbl-poker-form-grid">
      <div class="form-group">
        <label for="fbl-poker-edit-min">{{localize "FBLPoker.Fields.MinBuyIn"}}</label>
        <input id="fbl-poker-edit-min" type="number" name="minBuyIn" value="{{table.minBuyIn}}" min="1" required>
      </div>
      <div class="form-group">
        <label for="fbl-poker-edit-max">{{localize "FBLPoker.Fields.MaxBuyIn"}}</label>
        <input id="fbl-poker-edit-max" type="number" name="maxBuyIn" value="{{table.maxBuyIn}}" min="1" required>
      </div>
    </div>
  </fieldset>

  <fieldset class="fbl-poker-fieldset">
    <legend>{{localize "FBLPoker.Create.Sections.Automation"}}</legend>
    <div class="fbl-poker-form-grid">
      <label class="fbl-poker-checkbox-row">
        <input type="checkbox" name="autoNextHand" {{#if table.autoNextHand}}checked{{/if}}>
        <span>{{localize "FBLPoker.Fields.AutoNextHand"}}</span>
      </label>
      <div class="form-group">
        <label for="fbl-poker-edit-auto-next-seconds">{{localize "FBLPoker.Fields.AutoNextHandSeconds"}}</label>
        <input id="fbl-poker-edit-auto-next-seconds" type="number" name="autoNextHandSeconds" value="{{table.autoNextHandSeconds}}" min="1" max="120" required>
      </div>
    </div>
  </fieldset>

  <footer class="fbl-poker-form-footer">
    <button class="fbl-poker-primary" type="submit" data-action="submitTable"><i class="fa-solid fa-floppy-disk"></i> {{localize "FBLPoker.Edit.Submit"}}</button>
  </footer>
</section>
{{/if}}
